# EN: Copy to 07-ops/.env and fill. NEVER commit the real file. TESTNET / LOCAL VALUES ONLY.
# ES: Copiar a 07-ops/.env y completar. NUNCA commitear el archivo real. SOLO VALORES DE TESTNET / LOCAL.

# EN: Postgres password (generate: openssl rand -hex 24) / ES: Contraseña de Postgres
POSTGRES_PASSWORD=

# EN: Shared HMAC secret API <-> signer (openssl rand -hex 32) / ES: Secreto HMAC compartido API <-> firmante
SIGNER_HMAC_SECRET=

# EN: Hot wallet TESTNET key, signer only. For anvil use one of its printed dev keys.
# ES: Clave TESTNET de la hot wallet, solo el firmante. En anvil usar una de las claves dev que imprime.
HOT_WALLET_PRIVATE_KEY=
HOT_WALLET_ADDRESS=

# EN: Account-level xpub (m/44'/60'/0'/0) for deposit addresses. xprv is rejected.
# ES: xpub a nivel de cuenta (m/44'/60'/0'/0) para direcciones de depósito. Se rechaza xprv.
DEPOSIT_XPUB=

# EN: Signer allowlist "CODE:kind:contract:perTxMaxBaseUnits:dailyMaxBaseUnits", comma separated.
# ES: Lista permitida del firmante "CODIGO:tipo:contrato:topePorTx:topeDiario" (unidades base), separada por comas.
SIGNER_ASSETS=ETH:native::1000000000000000000:5000000000000000000

# EN: Token contracts after `forge script script/DeployLocal.s.sol` / ES: Contratos tras el deploy local
USDT_CONTRACT=
ANX_CONTRACT=

# EN: Bootstrap admins (two are needed for the 4-eyes rule) / ES: Admins iniciales (se necesitan dos)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=

# EN: URLs the BROWSER uses / ES: URLs que usa el NAVEGADOR
PUBLIC_API_URL=http://127.0.0.1:4000
CORS_ORIGIN=http://127.0.0.1:3000
