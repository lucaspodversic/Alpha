# EN: API / watcher config for local dev (npm run dev -w 04-api). Testnet/local only.
# ES: Config de API / watcher para desarrollo local. Solo testnet/local.
HOST=127.0.0.1
PORT=4000
# EN: Empty = embedded PGlite (in memory or PGLITE_DIR). Watcher + API sharing data need Postgres.
# ES: Vacío = PGlite embebido. Para que watcher y API compartan datos se necesita Postgres.
DATABASE_URL=
PGLITE_DIR=
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
SESSION_TTL_HOURS=12
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
# EN: Dev faucet credits fake balances; forced off when NODE_ENV=production.
# ES: El faucet de desarrollo acredita saldos ficticios; se apaga con NODE_ENV=production.
ALLOW_DEV_FAUCET=true
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
DEPOSIT_XPUB=
HOT_WALLET_ADDRESS=
SIGNER_URL=http://127.0.0.1:4100
SIGNER_HMAC_SECRET=
USDT_CONTRACT=
ANX_CONTRACT=
CONFIRMATIONS_ETH=12
CONFIRMATIONS_USDT=12
CONFIRMATIONS_ANX=12
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
WATCHER_POLL_MS=4000
RECONCILE_EVERY_MS=300000
WATCHER_START_BLOCK=
